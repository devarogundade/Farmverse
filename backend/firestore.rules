rules_version = '2';

// Farmverse security rules (08 §2, 11 §1.4).
//
// Every game-state write goes through Cloud Functions (the Admin SDK bypasses
// these rules). Clients only READ their own documents, with list queries capped
// at 50, plus exactly two direct writes that carry no economic value: their own
// settings, and marking a notification read.
// Anything not matched below is denied.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // a settings field added later: absent on older documents, a bool when present
    function optionalBool(data, key) {
      return !(key in data) || data[key] is bool;
    }

    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function page(max) { return request.query.limit != null && request.query.limit <= max; }

    // ---- the player's own world ------------------------------------------------

    match /players/{uid} {
      allow get: if isSelf(uid);

      match /state/{aggregate} {
        allow get: if isSelf(uid) && aggregate in ['island', 'wallet', 'inventory', 'shop', 'goals', 'daily', 'pass', 'purchases'];   // walletDay: server only
      }

      // friends rows are written by the server when an invite is accepted
      match /friends/{friendUid} {
        allow get: if isSelf(uid);
        allow list: if isSelf(uid) && page(50);
      }

      // rewards are written by the server and collected through rewards-claim
      match /rewards/{rewardId} {
        allow get: if isSelf(uid);
        allow list: if isSelf(uid) && page(50);
      }

      // coupon codes the server issued (coupons-claim); the pools they come from are server only
      match /coupons/{couponId} {
        allow get: if isSelf(uid);
        allow list: if isSelf(uid) && page(50);
      }

      match /notifications/{notificationId} {
        allow get: if isSelf(uid);
        allow list: if isSelf(uid) && page(50);
        // only readAt, only from unread (0) to "now" (client clock within 5 minutes of request.time)
        allow update: if isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && resource.data.readAt == 0
          && request.resource.data.readAt is int
          && request.resource.data.readAt > request.time.toMillis() - 300000
          && request.resource.data.readAt <= request.time.toMillis() + 300000;
      }

      match /private/settings {
        allow get: if isSelf(uid);
        allow update: if isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['allowVisitors', 'pushEnabled', 'quietStart', 'quietEnd', 'locale', 'timezone', 'reduceMotion', 'textScale',
                         'music', 'sound', 'vibration', 'hints', 'analyticsConsent', 'termsAcceptedAt', 'pushTopics'])
          && request.resource.data.allowVisitors is bool
          && request.resource.data.pushEnabled is bool
          && request.resource.data.quietStart is int && request.resource.data.quietStart >= 0 && request.resource.data.quietStart <= 23
          && request.resource.data.quietEnd is int && request.resource.data.quietEnd >= 0 && request.resource.data.quietEnd <= 23
          && request.resource.data.locale is string && request.resource.data.locale.size() <= 16
          && request.resource.data.timezone is string && request.resource.data.timezone.size() <= 64
          && request.resource.data.reduceMotion is bool
          && request.resource.data.textScale is int && request.resource.data.textScale >= 80 && request.resource.data.textScale <= 150
          && optionalBool(request.resource.data, 'music') && optionalBool(request.resource.data, 'sound')
          && optionalBool(request.resource.data, 'vibration') && optionalBool(request.resource.data, 'hints')
          && optionalBool(request.resource.data, 'analyticsConsent')
          // Settings → Notifications: one switch per push topic
          && (!('pushTopics' in request.resource.data)
              || (request.resource.data.pushTopics is map
                  && request.resource.data.pushTopics.keys().hasOnly(['island', 'raids', 'rewards', 'offers', 'news'])
                  && optionalBool(request.resource.data.pushTopics, 'island') && optionalBool(request.resource.data.pushTopics, 'raids')
                  && optionalBool(request.resource.data.pushTopics, 'rewards') && optionalBool(request.resource.data.pushTopics, 'offers')
                  && optionalBool(request.resource.data.pushTopics, 'news')))
          && (!('termsAcceptedAt' in request.resource.data)
              || (request.resource.data.termsAcceptedAt is int && request.resource.data.termsAcceptedAt >= 0
                  && request.resource.data.termsAcceptedAt <= request.time.toMillis() + 300000));
      }
      // pushTokens/*: server only (no rule = denied)
    }

    // the live tuning data (tools/publishCatalogue.ts); the same for everyone
    match /config/catalogue {
      allow get: if signedIn();
    }

    // the weekly leaderboard: rows written by the server whenever it runs an island
    match /leaderboards/{weekId}/players/{playerUid} {
      allow get: if signedIn();
      allow list: if signedIn() && page(50);
    }

    // the game's News, written by the team (tools/publishNews.ts)
    match /news/{newsId} {
      allow get: if signedIn();
      allow list: if signedIn() && page(20);
    }

    // usernames/*, counters/*, invites/*, referrals/*, content/*, players/*/ledger/*, couponCodes/*, iapTransactions/*: server only (content reaches clients through content-manifest)
  }
}
