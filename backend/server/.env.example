# Farmverse game server, worker and chain indexer: every setting they read (src/config.ts).
# Copy to .env. The values below run everything locally against NEAR testnet. A blank value
# (KEY=) means "use the default". Values marked SECRET must never be committed with real data.

# ---------------------------------------------------------------- infrastructure
# Postgres 17 and Redis 7 (local containers: see README).
DATABASE_URL=postgresql://farmverse:farmverse-dev@localhost:5432/farmverse
REDIS_URL=redis://localhost:6379
# The C# island engine (tools/dotnet/Farmverse.IslandEngine).
ISLAND_ENGINE_URL=http://localhost:8080

# ---------------------------------------------------------------- server
# dev | staging | prod. dev enables POST /v1/auth/dev (the Unity editor signs in without a wallet).
FARMVERSE_ENV=dev
PORT=8787
# Browser origins allowed to call the API, comma-separated: the WebGL game (5173),
# the marketplace (5174), the admin site (5177) and a local static build (8000).
# Production: https://play.farmverse.world,https://marketplace.farmverse.world,https://admin.farmverse.world,https://farmverse.world
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5177,http://localhost:8000
# Clients older than this are asked to update.
MIN_CLIENT_VERSION=0.0.0

# SECRET. Base64 of a 32-byte Ed25519 seed that signs session JWTs. This one is for local dev
# only: anyone who has it can forge sessions. Generate a fresh one for any shared server:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SEED=ZmFybXZlcnNlLWRldi1qd3Qtc2VlZC1ub3QtcHJvZCE=

# ---------------------------------------------------------------- NEAR and wallet sign-in
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
# The NEP-413 recipient wallets sign for (must match the game client).
AUTH_RECIPIENT=play.farmverse.world
# Accounts with admin rights (coupon redemption, publishing news), comma-separated.
ADMIN_ACCOUNTS=farmverse.testnet

# ---------------------------------------------------------------- contracts
# Written by chain/scripts/deploy-testnet.sh to chain/deploy/testnet.env. These are the names it
# uses with MASTER=farmverse.testnet.
NEAR_ITEMS_CONTRACT=items.farmverse.testnet
NEAR_MARKET_CONTRACT=market.farmverse.testnet

# ---------------------------------------------------------------- chain indexer (npm run start:indexer)
# Block feed. Default: https://<NEAR_NETWORK>.neardata.xyz
NEARDATA_URL=https://testnet.neardata.xyz
# SECRET. FastNEAR key. Without one the free tier (180 requests a minute per IP) can't keep up
# with testnet's ~100 blocks a minute.
NEARDATA_API_KEY=
# Requests a minute to neardata. Each block is one request. 200 follows testnet with room to
# catch up at ~1.7 blocks/s. Raise it for a long catch-up, then lower it again.
NEARDATA_RPM=200
# The block to start from on the very first run: the contracts' deploy block (deploy-testnet.sh
# prints it). Blank starts at the current block and misses anything earlier. Ignored once the
# indexer has a cursor in the database.
INDEXER_START_BLOCK=

# ---------------------------------------------------------------- minting (island → NFT)
# SECRET. Base64 of a 32-byte Ed25519 seed that signs mint vouchers. Its public key must be
# registered on the items contract (add_signer). deploy-testnet.sh generates and registers one
# when this is blank. Blank = minting is refused. Production: keep it in a KMS.
MINT_SIGNER_SEED=
# Market value (coins) one player may mint per UTC day.
MINT_DAILY_VALUE_CAP=5000
# Hours since a player started before they may mint.
MINT_MIN_ACCOUNT_HOURS=24

# B3TR coupon payouts on farmverse.world/redeem (VeBetterDAO X2EarnRewardsPool). Leave any empty: B3TR redeeming stays closed.
# Testnet node: https://testnet.vechain.org  Mainnet: https://mainnet.vechain.org
VECHAIN_NODE_URL=
X2EARN_REWARDS_POOL=
# The app id from VeBetterDAO (0x + 64 hex)
X2EARN_APP_ID=
# Private key of one of the app's reward distributors (never commit a real one)
X2EARN_SIGNER_KEY=
VECHAIN_EXPLORER_TX_URL=https://explore-testnet.vechain.org/transactions/

# ---------------------------------------------------------------- Market Town merchant voices
# SECRET. NEAR AI Cloud API key (cloud.near.ai; credits from nearbuilders.org). Each merchant explains its
# price moves in its own voice, written in a TEE and signed; the formula still sets every price.
# Blank = the merchants show the formula's fixed reason labels.
NEAR_AI_API_KEY=
# A private (TEE-hosted) model: GET https://cloud-api.near.ai/v1/models lists them.
NEAR_AI_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
# Seconds to wait for a note before falling back to the fixed label.
NEAR_AI_TIMEOUT_SECONDS=20
