# Local development (Postgres and Redis containers: see README).
DATABASE_URL=postgresql://farmverse:farmverse-dev@localhost:5432/farmverse
REDIS_URL=redis://localhost:6379
# Base64 of a 32-byte Ed25519 seed for session JWTs. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SEED=
ISLAND_ENGINE_URL=http://localhost:8080
FARMVERSE_ENV=dev
MIN_CLIENT_VERSION=0.0.0
PORT=8787
# Comma-separated origins allowed to call the API from a browser.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
# NEAR network for wallet sign-in: testnet | mainnet
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
# The NEP-413 recipient the game asks wallets to sign for.
AUTH_RECIPIENT=play.farmverse.world
# Accounts with admin rights (coupon redemption, publishing), comma-separated.
ADMIN_ACCOUNTS=
