rules_version = '2';

// Cloud Storage (11 §1.9): versioned content (`content/{platform}/{version}/…`,
// Addressables bundles written by tools/publishContent.ts) is read-only for
// signed-in players; everything else is server-only.
service firebase.storage {
  match /b/{bucket}/o {
    match /content/{version}/{allPaths=**} {
      allow read: if request.auth != null;
    }
  }
}
