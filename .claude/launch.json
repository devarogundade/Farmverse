{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "backend/server", "run", "dev"],
      "port": 8787,
      "url": "http://localhost:8787"
    },
    {
      "name": "marketplace",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev:market"],
      "port": 5174
    },
    {
      "name": "marketplace-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web/marketplace", "run", "dev", "--", "--port", "5176", "--strictPort"],
      "port": 5176
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev:admin"],
      "port": 5177
    },
    {
      "name": "admin-testserver",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--prefix", "web", "cross-env", "VITE_API_URL=http://localhost:8788", "npm", "--prefix", "web/admin", "run", "dev", "--", "--strictPort"],
      "port": 5177
    },
    {
      "name": "webgl-dev",
      "runtimeExecutable": "node",
      "runtimeArgs": ["Claude outputs/serve-webgl.mjs", "Builds/WebGL-dev", "5180"],
      "port": 5180
