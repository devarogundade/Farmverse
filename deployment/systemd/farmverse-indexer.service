[Unit]
Description=Farmverse chain indexer (NEAR blocks to Postgres)
After=network-online.target docker.service 
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/farmverse/server
EnvironmentFile=/etc/farmverse/server.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --enable-source-maps dist/indexer.js
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
