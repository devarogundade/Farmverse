# Farmverse marketplace (marketplace.farmverse.world): every setting it reads (src/config.ts).
# Copy to .env.local. The values below run against the local game API and NEAR testnet.
# Vite bakes these into the build, so never put a secret here.

# ---------------------------------------------------------------- game API (backend/server)
# The marketplace routes. Dev builds fall back to this when blank; production builds must set it
# (e.g. https://api.farmverse.world/v1/market).
VITE_API_URL=http://localhost:8787/v1/market
# Live market updates. Blank = the API URL's /live socket (ws:// or wss:// to match).
VITE_WS_URL=ws://localhost:8787/v1/market/live

# ---------------------------------------------------------------- NEAR
# testnet | mainnet. Mainnet only after the contracts are deployed and reviewed (docs §6).
VITE_NEAR_NETWORK=testnet
# RPC for reads (balances, listings, fee). Blank = rpc.<network>.near.org.
VITE_NEAR_RPC=https://rpc.testnet.near.org
# The contracts deploy-testnet.sh deploys with MASTER=farmverse.testnet.
VITE_ITEMS_CONTRACT=items.farmverse.testnet
VITE_MARKET_CONTRACT=market.farmverse.testnet
VITE_FARM_CONTRACT=farm.farmverse.testnet

# ---------------------------------------------------------------- features
# A token id for "Featured" in the menu (e.g. s-w1). Blank hides the menu item.
VITE_FEATURED_TOKEN=
# The game, for "Use in game" links (default: https://play.farmverse.world; dev: http://localhost:8000).
VITE_PLAY_URL=
