# The game API's marketplace routes (backend/server; its indexer process fills them).
# Dev builds default to http://localhost:8787/v1/market; production builds must set it.
VITE_API_URL=
# Live updates; defaults to the API URL's /live socket.
VITE_WS_URL=
# Optional: a token id to link from "Featured" in the menu.
VITE_FEATURED_TOKEN=
# Offers stay hidden until the backend serves them (set to "on" then).
VITE_OFFERS=

# NEAR: testnet first (docs §6); mainnet only after the contracts are deployed and reviewed.
VITE_NEAR_NETWORK=testnet
VITE_NEAR_RPC=
VITE_ITEMS_CONTRACT=items.farmverse.testnet
VITE_MARKET_CONTRACT=market.farmverse.testnet
VITE_FARM_CONTRACT=farm.farmverse.testnet
