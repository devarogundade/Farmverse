# Farmverse landing page (farmverse.world): every setting it reads (src/links.ts).
# Copy to .env.local. Vite bakes these into the build, so never put a secret here.

# Where "Play" goes. Default: https://play.farmverse.world
VITE_PLAY_URL=https://play.farmverse.world
# Where "Marketplace" goes. Default: the local marketplace in dev, else
# https://marketplace.farmverse.world
VITE_MARKET_URL=http://localhost:5174
