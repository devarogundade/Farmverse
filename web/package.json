{
  "name": "farmverse-web",
  "private": true,
  "description": "Farmverse websites: landing (farmverse.world), marketplace (marketplace.farmverse.world), admin (admin.farmverse.world) and the shared 3D/NFT code.",
  "workspaces": [
    "shared",
    "marketplace",
    "landing",
    "admin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:market": "npm run dev -w @farmverse/marketplace",
    "dev:landing": "npm run dev -w @farmverse/landing",
    "dev:admin": "npm run dev -w @farmverse/admin",
    "build": "npm run build -w @farmverse/marketplace -w @farmverse/landing -w @farmverse/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "models": "blender -b --factory-startup -P ../tools/blender/export_marketplace_models.py"
  }
}
