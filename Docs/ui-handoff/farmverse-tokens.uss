/* Farmverse design tokens, generated from the UI canvas (fv.css). */
:root {
    --fv-header-top: #1259B4;
    --fv-header-bottom: #0C4794;
    --fv-accent-rule: #F08A12;
    --fv-page-top: #4A6585;
    --fv-page-bottom: #3C5675;
    --fv-inset: #34506F;
    --fv-dialog-body: #2563B0;
    --fv-dialog-rim: #4FA7EA;
    --fv-dialog-outline: #0E3E6E;
    --fv-reward-body: #E8901A;
    --fv-reward-rim: #FFD866;
    --fv-reward-outline: #7A3F05;
    --fv-row-top: #FFF9EA;
    --fv-row-bottom: #F7E8C6;
    --fv-row-lip: #E3CB98;
    --fv-value-box: #E9D7AE;
    --fv-ink: #22324A;
    --fv-ink-muted: #6F82A0;
    --fv-title-light: #FFFFF0;
    --fv-title-mid: #FFB300;
    --fv-title-dark: #F08A00;
    --fv-title-outline: #5A2A06;
    --fv-timer-top: #A8283B;
    --fv-timer-bottom: #7C1829;
    --fv-alert-top: #FF7A6A;
    --fv-alert-bottom: #E0412E;
    --fv-ready-top: #FFE27A;
    --fv-ready-bottom: #F5B323;
    --fv-featured: #B68CF5;
    --fv-offline-top: #5E6F84;
    --fv-offline-bottom: #4C5B6E;
    --fv-scrim: rgba(6,24,50,0.55);
    --fv-scrim-reward: rgba(40,16,4,0.55);
    --fv-type-screen-title: 38px;
    --fv-type-dialog-title: 30px;
    --fv-type-button-big: 26px;
    --fv-type-button-pair: 20px;
    --fv-type-row-name: 19px;
    --fv-type-section: 18px;
    --fv-type-body: 16px;
    --fv-type-label: 13px;
    --fv-type-small: 13.5px;
    --fv-space-xs: 4px;
    --fv-space-s: 8px;
    --fv-space-list-gap: 10px;
    --fv-space-pair-gap: 12px;
    --fv-space-gutter: 14px;
    --fv-space-card: 16px;
    --fv-space-bottom-safe: 24px;
    --fv-radius-value: 9px;
    --fv-radius-small-button: 14px;
    --fv-radius-row: 16px;
    --fv-radius-button: 20px;
    --fv-radius-dialog: 28px;
    --fv-size-header: 100px;
    --fv-size-accent-rule: 5px;
    --fv-size-tab-bar: 86px;
    --fv-size-button-big: 60px;
    --fv-size-button-small: 44px;
    --fv-size-price-chip: 42px;
    --fv-size-icon-button: 46px;
    --fv-size-tap-min: 48px;
    --fv-size-dialog-rim: 12px;
    --fv-size-button-lip: 4px;
    --fv-motion-push-ms: 240;
    --fv-motion-push-dp: 24;
    --fv-motion-dialog-ms: 200;
    --fv-motion-press-ms: 80;
    --fv-motion-press-dp: 4;
    --fv-motion-bar-ms: 300;
    --fv-motion-reward-ms: 500;
    --fv-motion-reduced-ms: 120;
    --fv-btn-grass-top: #9BE85A;
    --fv-btn-grass-bottom: #3FAE24;
    --fv-btn-grass-lip: #2E8A18;
    --fv-btn-grass-outline: #1F5E10;
    --fv-btn-harvest-top: #FFC54A;
    --fv-btn-harvest-bottom: #F08A12;
    --fv-btn-harvest-lip: #C96A06;
    --fv-btn-harvest-outline: #7A3F05;
    --fv-btn-sky-top: #6CC6FF;
    --fv-btn-sky-bottom: #2A84D3;
    --fv-btn-sky-lip: #1C66AE;
    --fv-btn-sky-outline: #0E3E6E;
    --fv-btn-plum-top: #C9A6F2;
    --fv-btn-plum-bottom: #8C5BD6;
    --fv-btn-plum-lip: #6E3FB8;
    --fv-btn-plum-outline: #3E1F73;
    --fv-btn-berry-top: #FF8A7A;
    --fv-btn-berry-bottom: #E0412E;
    --fv-btn-berry-lip: #B32E1E;
    --fv-btn-berry-outline: #6E1408;
    --fv-btn-slate-top: #8FB0CF;
    --fv-btn-slate-bottom: #5A7FA3;
    --fv-btn-slate-lip: #456685;
    --fv-btn-slate-outline: #1E3550;
    --fv-btn-cloud-top: #FFFFFF;
    --fv-btn-cloud-bottom: #E9EEF3;
    --fv-btn-cloud-lip: #C9D3DD;
    --fv-btn-cloud-outline: #3A4A5C;
}
