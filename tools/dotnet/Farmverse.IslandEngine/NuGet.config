<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The island engine is a real ASP.NET app: when the installed SDK is newer than net8.0, its reference
    packs (Microsoft.NETCore.App.Ref, Microsoft.AspNetCore.App.Ref…) come from nuget.org. The engine-free
    test build (tools/dotnet/NuGet.config) stays offline.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
