<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    The island engine: the game's own island rules (Farmverse.Domain, the same source Unity compiles)
    served over HTTP for the backend. Stateless; Cloud Functions send an island and get it back advanced.
    Deployed to Cloud Run (see deploy.sh); not reachable from the internet, only by the backend's service account.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Farmverse.IslandEngine</RootNamespace>
    <AssemblyName>Farmverse.IslandEngine</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- minimal-API lambdas need C# 10+; the shared rules (Domain) stay on Unity's C# 9 -->
    <LangVersion>12.0</LangVersion>
    <!-- a PC with only a newer .NET runtime (10, 11…) still runs the engine locally; Cloud Run's image has 8 -->
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <ProjectReference Include="../Farmverse.Domain/Farmverse.Domain.csproj" />
  </ItemGroup>
</Project>
